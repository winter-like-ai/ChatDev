from hello_world import print_message

class HelloWorldApp:
    '''
    Class to create the Hello World application GUI.
    '''
    def __init__(self, master):
        '''
        Initializes the main window and GUI components.
        '''
        self.master = master
        master.title("Hello World App")
        
        self.label = Label(master, text="")  # Create a label to display messages
        self.label.pack()
        
        self.button = Button(master, text="Print Hello World", command=self.print_message)
        self.button.pack()

    def print_message(self):
        '''
        Calls the function to print "Hello World" and updates the label.
        '''
        message = print_message()  # Get the message from the function
        self.label.config(text=message)  # Update the label with the message

if __name__ == "__main__":
    root = Tk()
    app = HelloWorldApp(root)
    root.mainloop()
```

