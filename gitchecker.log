import tkinter as tk  
from tkinter import filedialog, messagebox  
from word_counter import WordCounter  
class WordCounterGUI:  
    """  
    A class to implement the GUI for the word counter application.  
    """  
    def __init__(self):  
        """  
        Initializes the GUI components.  
        """  
        self.root = tk.Tk()  
        self.root.title("Word Counter")  
        self.root.geometry("400x200")  
        # File path label and entry  
        self.file_path_label = tk.Label(self.root, text="File Path:")  
        self.file_path_label.pack(pady=5)  
        self.file_path_entry = tk.Entry(self.root, width=40)  
        self.file_path_entry.pack(pady=5)  
        # Browse button  
        self.browse_button = tk.Button(self.root, text="Browse", command=self.browse_file)  
        self.browse_button.pack(pady=5)  
        # Count words button  
        self.count_button = tk.Button(self.root, text="Count Words", command=self.count_words)  
        self.count_button.pack(pady=10)  
        # Result label  
        self.result_label = tk.Label(self.root, text="", fg="blue")  
        self.result_label.pack(pady=10)  
    def browse_file(self):  
        """  
        Opens a file dialog to select a text file.  
        """  
        file_path = filedialog.askopenfilename(filetypes=[("Text Files", "*.txt")])  
        if file_path:  
            self.file_path_entry.delete(0, tk.END)  
            self.file_path_entry.insert(0, file_path)  
    def count_words(self):  
        """  
        Calls the WordCounter class to count words and displays the result.  
        """  
        file_path = self.file_path_entry.get()  
        if not file_path:  
            messagebox.showerror("Error", "Please select a file.")  
            return  
        try:  
            word_count = WordCounter.count_words(file_path)  
            self.result_label.config(text=f"Total Words: {word_count}")  
        except FileNotFoundError:  
            messagebox.showerror("Error", "The specified file was not found.")  
        except Exception as e:  
            messagebox.showerror("Error", str(e))  
    def run(self):  
        """  
        Runs the GUI application.  
        """  
        self.root.mainloop()  
