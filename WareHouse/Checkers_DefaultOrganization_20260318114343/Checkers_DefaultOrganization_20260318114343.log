def process_move_notation(self, notation):
    """Process move notation like 'c3-d4' or 'c3xe5'."""
    notation = notation.strip().lower()
    
    # Parse notation
    if '-' in notation:  # Regular move
        from_pos, to_pos = notation.split('-')
    elif 'x' in notation:  # Capture move
        from_pos, to_pos = notation.split('x')
    else:
        return False
    
    # Convert algebraic notation to board coordinates
    def notation_to_coords(alg):
        if len(alg) != 2:
            return None
        col = ord(alg[0]) - ord('a')
        row = 8 - int(alg[1])
        return (row, col) if 0 <= row < 8 and 0 <= col < 8 else None
    
    from_coords = notation_to_coords(from_pos)
    to_coords = notation_to_coords(to_pos)
    
