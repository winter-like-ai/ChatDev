    """Main function to initialize and run the Checkers game."""
    # Initialize Pygame
    pygame.init()
    # Create game instance
    game = Game()
    # Create GUI instance
    gui = CheckersGUI(game)
    # Run the game
    gui.run()
if __name__ == "__main__":
    main()
