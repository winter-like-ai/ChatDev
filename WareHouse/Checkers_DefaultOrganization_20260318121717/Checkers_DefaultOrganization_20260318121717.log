class TextInput:
    """Simple text input handler for Pygame."""
    def __init__(self, font_size=24):
        self.font = pygame.font.SysFont(None, font_size)
        self.value = ""
        self.active = False
        self.cursor_visible = True
        self.cursor_timer = 0
        
    def update(self, events):
        """Process events for text input."""
        for event in events:
            if event.type == pygame.KEYDOWN and self.active:
                if event.key == pygame.K_RETURN:
                    pass  # Handled elsewhere
                elif event.key == pygame.K_BACKSPACE:
                    self.value = self.value[:-1]
                elif event.key == pygame.K_TAB:
                    pass  # Handled elsewhere
                elif event.unicode.isprintable():
                    self.value += event.unicode
        
        # Blink cursor
        self.cursor_timer = (self.cursor_timer + 1) % 60
        self.cursor_visible = self.cursor_timer < 30
        
    def get_surface(self):
        """Get rendered text surface with cursor."""
        text = self.value
        if self.active and self.cursor_visible:
            text += "|"
        return self.font.render(text, True, TEXT_COLOR)
