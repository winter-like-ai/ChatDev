'''

This file contains the main application class `WordCountApp` that manages the GUI for the word count tool. It allows users to select a text file, calculates the word count using a utility function, and displays the result.

'''

import tkinter as tk
from tkinter import filedialog, messagebox
from utils import count_words_in_file

class WordCountApp:
    def __init__(self):
        self.root = tk.Tk()
        self.root.title("Word Count Tool")
        self.root.geometry("400x200")

        # GUI Components
        self.label = tk.Label(self.root, text="Select a text file to count words:", font=("Arial", 12))
        self.label.pack(pady=10)

        self.select_button = tk.Button(self.root, text="Select File", command=self.select_file, font=("Arial", 12))
        self.select_button.pack(pady=10)

        self.result_label = tk.Label(self.root, text="", font=("Arial", 12))
        self.result_label.pack(pady=10)

    def select_file(self):
        file_path = filedialog.askopenfilename(filetypes=[("Text Files", "*.txt")])
        if file_path:
            try:
                word_count = count_words_in_file(file_path)
                self.display_result(word_count)
            except Exception as e:
                messagebox.showerror("Error", f"An error occurred: {e}")

    def display_result(self, count):
        self.result_label.config(text=f"Total Word Count: {count}")

    def run(self):
        self.root.mainloop()

if __name__ == "__main__":
    app = WordCountApp()
    app.run()
```

---

### File 2: `utils.py`

```python
'''

This file contains the utility function `count_words_in_file` that calculates the total word count in a given text file. It handles basic punctuation and counts sequences of alphanumeric characters as words.

'''

import re

def count_words_in_file(file_path):
    """
    Count the total number of words in a text file.

    Args:
        file_path (str): Path to the text file.

    Returns:
        int: Total word count.
    """
    try:
        with open(file_path, 'r', encoding='utf-8') as file:
            text = file.read()
            # Use regex to find sequences of alphanumeric characters
            words = re.findall(r'\b\w+\b', text)
            return len(words)
    except FileNotFoundError:
        raise FileNotFoundError("The specified file was not found.")
    except Exception as e:
        raise Exception(f"An error occurred while processing the file: {e}")
```

---

### Explanation of the Code
1. **`main.py`**:
   - Implements the GUI using `tkinter`.
   - Provides a button for file selection and displays the word count result.
   - Calls the utility function `count_words_in_file` to perform the word count.

2. **`utils.py`**:
   - Contains the core logic for counting words in a text file.
   - Uses regex (`\b\w+\b`) to identify sequences of alphanumeric characters as words.

---

### How to Run the Tool
1. Save the code into two files: `main.py` and `utils.py`.
2. Run `main.py` using Python (`python main.py`).
3. Use the GUI to select a text file and view the word count.

This implementation satisfies the customer's requirements and provides a user-friendly interface for the CLI tool.

