    # Create a deep copy of the board state
    simulated_board = Board()
    simulated_board.board = [row[:] for row in board_state.board]
    
    # Move the piece
    simulated_board.board[piece.row][piece.col] = EMPTY
    simulated_board.board[new_row][new_col] = piece
    
    # Remove captured piece if any
    if capture_row is not None and capture_col is not None:
        simulated_board.board[capture_row][capture_col] = EMPTY
    
    return simulated_board
