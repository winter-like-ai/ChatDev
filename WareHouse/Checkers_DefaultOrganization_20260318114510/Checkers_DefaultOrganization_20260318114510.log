def get_capture_moves(self, piece, board_state=None):
    """Get all possible capture sequences for a piece."""
    if board_state is None:
        board_state = self.board
    
    moves = []
    row, col = piece.row, piece.col
    
    # Check all four diagonal directions
    directions = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
    
    for dr, dc in directions:
        # Check if there's an opponent piece to jump over
        jump_row, jump_col = row + dr, col + dc
        land_row, land_col = row + 2*dr, col + 2*dc
        
        # Validate landing position
        if not (0 <= land_row < ROWS and 0 <= land_col < COLS):
            continue
            
        # Check if landing position is empty
        if board_state.get_piece(land_row, land_col) is not None:
            continue
            
        # Check if there's an opponent piece to capture
        jumped_piece = board_state.get_piece(jump_row, jump_col)
        if not jumped_piece or jumped_piece.color == piece.color:
            continue
            
        # Create a simulated board to check for further captures
        simulated_board = self.simulate_move(board_state, piece, land_row, land_col, 
                                           jump_row, jump_col)
        
        # Check for additional captures from the new position
        further_captures = self.get_capture_moves(piece, simulated_board)
        
        if further_captures:
            # Add intermediate positions for chain captures
            for further_move in further_captures:
                moves.append((land_row, land_col, further_move))
        else:
            moves.append((land_row, land_col))
    
    return moves

def simulate_move(self, board_state, piece, new_row, new_col, 
                  capture_row=None, capture_col=None):
