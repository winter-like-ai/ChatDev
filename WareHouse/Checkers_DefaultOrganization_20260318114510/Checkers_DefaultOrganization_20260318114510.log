            for further_move in further_captures:
                moves.append((land_row, land_col, further_move))
        else:
            moves.append((land_row, land_col))
    
    return moves

def simulate_move(self, board_state, piece, new_row, new_col, 
                  capture_row=None, capture_col=None):
