BLUE = (0, 0, 255)
GREEN = (0, 255, 0)
LIGHT_BROWN = (210, 180, 140)
DARK_BROWN = (139, 69, 19)
HIGHLIGHT = (255, 255, 0, 128)  # Semi-transparent yellow

# Board dimensions
ROWS = 8
COLS = 8
SQUARE_SIZE = 80
WIDTH = COLS * SQUARE_SIZE
HEIGHT = ROWS * SQUARE_SIZE + 50  # Extra space for game info
FPS = 60

# Game states
PLAYER_RED = "RED"
PLAYER_BLUE = "BLUE"
EMPTY = "EMPTY"
