        if 0 <= new_row < 8:
            # Left diagonal
            new_col = self.col - 1
            if 0 <= new_col < 8 and board[new_row][new_col] == 0:
                moves.append((new_row, new_col))
            # Right diagonal
            new_col = self.col + 1
