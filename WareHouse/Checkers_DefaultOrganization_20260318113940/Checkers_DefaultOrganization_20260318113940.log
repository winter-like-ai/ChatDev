'''
notation.py
Module for parsing algebraic notation in Checkers.
'''

def parse_notation(notation):
    """
    Parse algebraic notation for checkers moves.
    
    Args:
        notation: Move in notation format (e.g., "c3-d4", "a5xb6")
    
    Returns:
        tuple: (from_pos, to_pos, is_capture)
        where from_pos and to_pos are (row, col) tuples
        and is_capture is a boolean
    
    Raises:
        ValueError: If notation format is invalid
    """
    # Clean the notation
    notation = notation.strip().lower()
    
    # Check if it's a capture (contains 'x') or regular move (contains '-')
    if 'x' in notation:
        is_capture = True
        separator = 'x'
    elif '-' in notation:
        is_capture = False
        separator = '-'
    else:
        raise ValueError("Invalid notation format. Use '-' for moves or 'x' for captures")
    
    # Split the notation
    parts = notation.split(separator)
    if len(parts) != 2:
        raise ValueError("Invalid notation format. Expected format: 'a3-b4' or 'a3xb4'")
    
    from_square, to_square = parts
    
    # Parse from square
    try:
        from_col = ord(from_square[0]) - ord('a')
        from_row = 8 - int(from_square[1])  # Convert to 0-indexed row
    except (IndexError, ValueError):
        raise ValueError(f"Invalid from square: {from_square}")
    
    # Parse to square
    try:
        to_col = ord(to_square[0]) - ord('a')
        to_row = 8 - int(to_square[1])  # Convert to 0-indexed row
    except (IndexError, ValueError):
        raise ValueError(f"Invalid to square: {to_square}")
    
    # Validate coordinates
    if not (0 <= from_row < 8 and 0 <= from_col < 8):
        raise ValueError(f"From square {from_square} is out of board bounds")
    
    if not (0 <= to_row < 8 and 0 <= to_col < 8):
        raise ValueError(f"To square {to_square} is out of board bounds")
    
    return (from_row, from_col), (to_row, to_col), is_capture


def position_to_notation(row, col):
    """
    Convert board coordinates to algebraic notation.
    
    Args:
        row: Row position (0-7)
        col: Column position (0-7)
    
    Returns:
        str: Algebraic notation (e.g., "a1", "h8")
    """
    if not (0 <= row < 8 and 0 <= col < 8):
        raise ValueError("Coordinates out of bounds")
    
    col_char = chr(ord('a') + col)
    row_num = 8 - row
    return f"{col_char}{row_num}"


def move_to_notation(from_pos, to_pos, is_capture=False):
    """
    Convert a move to algebraic notation.
    
    Args:
        from_pos: (row, col) tuple for starting position
        to_pos: (row, col) tuple for destination position
        is_capture: Whether the move is a capture
    
    Returns:
        str: Move in algebraic notation
    """
    from_notation = position_to_notation(from_pos[0], from_pos[1])
    to_notation = position_to_notation(to_pos[0], to_pos[1])
    separator = 'x' if is_capture else '-'
    return f"{from_notation}{separator}{to_notation}"
```

