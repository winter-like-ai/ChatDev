'''
notation.py
Module for parsing algebraic notation moves in Checkers.
'''
import constants

def parse_notation(notation):
    """
    Parse algebraic notation for checkers moves.
    Args:
        notation: String in format like "c3-d4" (move) or "a5xb6" (capture)
    Returns:
        tuple: (from_pos, to_pos, is_capture) where positions are (row, col)
    Raises:
        ValueError: If notation is invalid
    """
    # Remove any whitespace
    notation = notation.strip()
    
    # Determine if it's a capture (contains 'x') or a move (contains '-')
    if 'x' in notation:
        is_capture = True
        separator = 'x'
    elif '-' in notation:
        is_capture = False
        separator = '-'
    else:
        raise ValueError("Notation must contain '-' for moves or 'x' for captures")
    
    # Split into from and to positions
    parts = notation.split(separator)
    if len(parts) != 2:
        raise ValueError(f"Invalid notation format: {notation}")
    
    from_str, to_str = parts
    
    # Convert algebraic notation to board coordinates
    try:
        from_pos = algebraic_to_coords(from_str)
        to_pos = algebraic_to_coords(to_str)
    except (ValueError, IndexError) as e:
        raise ValueError(f"Invalid position in notation: {e}")
    
    return from_pos, to_pos, is_capture

def algebraic_to_coords(algebraic):
    """
    Convert algebraic notation (e.g., 'a1', 'c3') to board coordinates (row, col).
    Args:
        algebraic: String like 'a1' where letter is column (a-h), number is row (1-8)
    Returns:
        tuple: (row, col) where row is 0-7, col is 0-7
    """
    if len(algebraic) != 2:
        raise ValueError(f"Invalid algebraic notation: {algebraic}")
    
    col_char = algebraic[0].lower()
    row_char = algebraic[1]
    
    # Convert column letter to number (a=0, b=1, ..., h=7)
    if col_char < 'a' or col_char > 'h':
        raise ValueError(f"Column must be a-h, got: {col_char}")
    col = ord(col_char) - ord('a')
    
    # Convert row number (1-8) to board row (7-0 since row 1 is bottom)
    try:
        row_num = int(row_char)
    except ValueError:
        raise ValueError(f"Row must be 1-8, got: {row_char}")
    
    if row_num < 1 or row_num > 8:
        raise ValueError(f"Row must be 1-8, got: {row_num}")
    
    # In checkers, row 1 is at the bottom (board row 7), row 8 is at the top (board row 0)
    row = 8 - row_num
    
    return (row, col)

def coords_to_algebraic(row, col):
    """
    Convert board coordinates to algebraic notation.
    Args:
        row: Board row (0-7)
        col: Board column (0-7)
    Returns:
        str: Algebraic notation like 'a1'
    """
    if row < 0 or row >= constants.BOARD_SIZE or col < 0 or col >= constants.BOARD_SIZE:
        raise ValueError(f"Coordinates out of bounds: ({row}, {col})")
    
    # Convert column number to letter
    col_char = chr(ord('a') + col)
    
    # Convert board row to algebraic row (1-8)
    row_num = 8 - row
    
    return f"{col_char}{row_num}"
