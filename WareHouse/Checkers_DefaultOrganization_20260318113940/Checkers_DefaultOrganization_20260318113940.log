1. **Modify `game.py` - `select()` method:**
```python
def select(self, row, col):
    """Select a piece or a position to move to."""
    if self.game_over:
        return False
    
    piece = self.board.get_piece(row, col)
    
    # Check if there are mandatory capture moves available
    has_captures = self.board.has_capture_moves(self.turn)
    
    # If a piece is already selected, try to move it
    if self.selected and (row, col) in self.valid_moves:
        result = self._move(row, col)
        if not result:
            self.selected = None
            self.select(row, col)
    else:
        # Select a new piece
        if piece != 0 and piece.color == self.turn:
            # If there are capture moves available, only allow selection of pieces that can capture
            if has_captures:
                piece_moves = self.board.get_valid_moves(piece)
                # Check if this piece has any capture moves
                has_capture_move = any(move for move in piece_moves.values() if move)
                if not has_capture_move:
                    return False  # Don't select pieces that can't capture when captures are mandatory
            
            self.selected = piece
            self.valid_moves = self.board.get_valid_moves(piece)
            return True
    return False
```

2. **Modify `game.py` - `_move()` method to validate capture requirement:**
```python
def _move(self, row, col):
    """Execute a move."""
    piece = self.selected
    destination = self.valid_moves.get((row, col))
    
    if not destination:
        return False
    
    # Check if capture is mandatory and this move doesn't capture
    has_captures = self.board.has_capture_moves(self.turn)
    if has_captures and not destination:
        return False  # Must capture when captures are available
    
    # Move the piece
    self.board.move(piece, row, col)
    
    # Remove captured pieces
    if destination:
        self.board.remove(destination)
    
    # Check for king promotion
    self._check_king(piece)
    
    # Check for additional captures (multiple jumps)
    if destination:
        # Check if the moved piece can capture again from its new position
        new_moves = self.board.get_valid_moves(piece)
        has_more_captures = any(move for move in new_moves.values() if move)
        
        if has_more_captures:
            # Keep the same piece selected for multiple jumps
            self.selected = piece
            self.valid_moves = new_moves
            return True
    
    # Switch turns if no more captures
    self.change_turn()
    
    # Clear selection
    self.selected = None
    self.valid_moves = {}
    
    # Check for winner
    self._check_winner()
    return True
```

3. **Add helper method to `game.py`:**
```python
def get_mandatory_capture_pieces(self):
    """Get all pieces that have mandatory capture moves."""
    capture_pieces = []
    for row in range(constants.BOARD_SIZE):
        for col in range(constants.BOARD_SIZE):
            piece = self.board.get_piece(row, col)
            if piece and piece.color == self.turn:
                moves = self.board.get_valid_moves(piece)
                if any(move for move in moves.values() if move):
                    capture_pieces.append(piece)
    return capture_pieces
```

This fix ensures that:
1. When capture moves are available, players can only select pieces that can capture
2. Players must execute capture moves when available
3. Multiple jumps are properly handled
4. The game follows standard checkers rules

