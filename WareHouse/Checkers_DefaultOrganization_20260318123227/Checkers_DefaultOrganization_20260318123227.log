            # Draw everything
            self.screen.fill((255, 255, 255))
            self.draw_board()
            self.draw_pieces()
            self.draw_selection()
            self.draw_status()
            self.draw_move_notation()
            self.show_move_prompt()
            
            pygame.display.flip()
        
        pygame.quit()
        sys.exit()
